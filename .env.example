# Database
DATABASE_URL=postgresql+asyncpg://learning_dna:learning_dna@localhost:5432/learning_dna
DATABASE_URL_SYNC=postgresql://learning_dna:learning_dna@localhost:5432/learning_dna
POSTGRES_USER=learning_dna
POSTGRES_PASSWORD=learning_dna
POSTGRES_DB=learning_dna

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production-use-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM Provider: anthropic | ollama | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Set to 'st' to use sentence-transformers (needs requirements-ml.txt); default is a built-in hashing embedding
EMBEDDING_BACKEND=hash

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# App
DEMO_MODE=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
CORS_ORIGINS=
